# Frontend environment variables for OceanShop

# Backend API base. For local dev when backend is on :3001 use:
# REACT_APP_API_BASE=http://localhost:3001/api
# If the React app is served by the Django backend on the same domain, you can use:
# REACT_APP_API_BASE=/api
REACT_APP_API_BASE=http://localhost:3001/api

# Optional Supabase placeholders (not required unless integrating Supabase)
# REACT_APP_SUPABASE_URL=
# REACT_APP_SUPABASE_ANON_KEY=
# REACT_APP_SITE_URL=http://localhost:3000
